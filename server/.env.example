# Server Port
PORT=5000

# MongoDB Connection String (e.g. mongodb://localhost:27017/packmaster or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/packmaster

# NVIDIA NIM API Key (OpenAI-compatible endpoint https://integrate.api.nvidia.com/v1/chat/completions)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Firebase Admin Service Account (Optional for local testing; mock fallback provided for offline viva testing)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="your_firebase_private_key"
